<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
    <name>FreekiCAD</name>
    <description>FreeCAD workbench for bidirectional KiCad PCB integration via kipy IPC API.</description>
    <version>7.5</version>
    <date>2026-09-19</date>
    <freecadmin>1.0.0</freecadmin>
    <pythonmin>3.10</pythonmin>
    <maintainer email="buganini@b612.tw">Buganini Chiu</maintainer>
    <license file="LICENSE">MIT</license>
    <icon>freecad/FreekiCAD/resources/icons/FreekiCAD.svg</icon>
    <url type="repository" branch="main">https://github.com/buganini/FreekiCAD</url>
    <url type="bugtracker">https://github.com/buganini/FreekiCAD/issues</url>
    <url type="readme">https://github.com/buganini/FreekiCAD/raw/main/README.md</url>
    <depend type="python" optional="true" version_gte="0.8.0" version_lt="0.9.0">kicad-python</depend>
    <depend type="python" optional="true" version_gte="2.0.7">shapely</depend>
    <depend type="python" version_gte="5.9">psutil</depend>
    <content>
        <workbench>
            <classname>FreekiCADWorkbench</classname>
            <subdirectory>./</subdirectory>
        </workbench>
    </content>
</package>
